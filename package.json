{
  "name": "vyrsea-monitor",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --port 8787 --test-scheduled",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/check-site.mjs",
    "audit": "node scripts/audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:probe": "node scripts/smoke-probe.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.mjs",
    "preview": "wrangler dev --port 8787 --test-scheduled",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldts": "^7.4.19",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.11",
    "lighthouse": "13.0.0",
    "miniflare": "latest",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=22.19"
  }
}
