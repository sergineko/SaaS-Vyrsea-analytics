{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vyrsea-monitor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://vyrsea.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFhA6rhUzje32QRc",
    "PUBLIC_SITE_URL": "https://vyrsea.com",
    "CLOUDFLARE_ACCOUNT_ID": "93d96c1211328e81e46cb2bc8af30d47",
    "DATABASE_PROVIDER": "supabase",
    "DATABASE_SCHEMA": "vyrsea",
    "CLOUDFLARE_QUEUE_ID": "8d42e8848d624eb4b0017a0ed12927ad",
    "CLOUDFLARE_SCRIPT_NAME": "vyrsea-monitor"
  },
  "hyperdrive": [{"binding":"HYPERDRIVE","id":"c67a878ad5864e18b633d97348f8b75f"}],
  "queues": {
    "producers": [
      {
        "binding": "CHECK_QUEUE",
        "queue": "vyrsea-checks"
      }
    ],
    "consumers": [
      {
        "queue": "vyrsea-checks",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "max_concurrency": 3,
        "dead_letter_queue": "vyrsea-dead-letters"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "account_id": "93d96c1211328e81e46cb2bc8af30d47",
  "preview_urls": false,
  "routes": [
    {
      "pattern": "vyrsea.com/*",
      "zone_id": "f645d506fbcaa010ce7ba080317cb453"
    }
  ]
}
